# Copy to .env and fill in. .env is gitignored - never commit real keys.
#
# The upstream Node bot uses these same variable names, so one .env can serve
# both projects if you keep them side by side.

# --- Market data / execution (Alpaca) ---------------------------------------
# Free accounts can only read the IEX feed; upgrade to SIP before trusting a
# backtest on thinly traded names.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
APCA_API_BASE_URL=https://paper-api.alpaca.markets

# --- Time-series foundation model (optional) --------------------------------
# Without this the project uses the offline Theta baseline, which is also the
# control you should benchmark TimeGPT against. Nothing breaks if it is unset.
NIXTLA_API_KEY=
MTGPT_FORECAST_BACKEND=theta        # theta | random_walk | timegpt

# --- Regime service, read by integration/hft-node-bot/regime.mjs ------------
REGIME_SERVICE_URL=http://127.0.0.1:8000
REGIME_TIMEOUT_MS=25
REGIME_ENABLED=true

# --- Upstream news pipeline (only needed if you run the Node bot) -----------
BENZINGA_API_KEY=
OPENAI_API_KEY=
FMP_API_KEY=
